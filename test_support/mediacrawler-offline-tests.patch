+def test_excel_export_round_trip(tmp_path, monkeypatch):
+    """Exported column names and values survive a workbook reload."""
+    monkeypatch.chdir(tmp_path)
+    store = ExcelStoreBase(platform="test", crawler_type="search")
+    asyncio.run(store.store_content({"note_id": "offline-note", "title": "离线测试"}))
+    store.flush()
+    workbook = openpyxl.load_workbook(store.filename)
+    try:
+        assert list(workbook["Contents"].values) == [
+            ("note_id", "title"), ("offline-note", "离线测试")
+        ]
+    finally:
+        workbook.close()
 
 
